[Unit]
Description=Etekcity smart scale BLE logging daemon
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=etekcity-scale-daemon
Group=etekcity-scale-daemon
SupplementaryGroups=bluetooth
ExecStart=/usr/bin/etekcity-scale-daemon --config /etc/etekcity-scale-daemon/config.ini
Restart=on-failure
RestartSec=5
StateDirectory=etekcity-scale-daemon

# Sandboxing. /etc/etekcity-scale-daemon is explicitly kept writable: on
# first run the daemon discovers the scale and rewrites its address/model
# back into the config file there (see persist_discovered_scale()).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/etekcity-scale-daemon
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
