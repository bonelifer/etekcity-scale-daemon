[scale]
# Leave address and model empty to auto-discover a supported scale on first
# run (step on the scale while the daemon is scanning). Once discovered,
# this file is updated automatically so future restarts reconnect directly
# instead of scanning again.
address =
model =
# Optional BLE adapter to use, e.g. hci0 (Linux only). Leave empty for the
# system default adapter.
adapter =
# BLE scanning mode: active or passive (Linux only; other platforms always
# scan actively).
scanning_mode = active
# Seconds to ignore advertisements after a disconnection. Only applies to
# GATT-based scales (ESF-551, ESF-24, EFS-A591S).
cooldown_seconds = 5

[storage]
# Path to the SQLite database file where measurements are recorded.
db_path = /var/lib/etekcity-scale-daemon/measurements.db

[daemon]
# Logging level: DEBUG, INFO, WARNING, ERROR
log_level = INFO
